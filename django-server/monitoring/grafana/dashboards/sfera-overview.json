      "title": "Загрузка относительно максимума (%)  ·  может превышать 100%",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 79
      },
      "description": "Общая нагрузка к номинальной ёмкости ($max_ops оп/сек), но не ниже загрузки CPU/памяти. Свыше 100% = перегруз.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 130,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      },
      "options": {
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(scalar(max({__name__=~\"sfera_cpu_percent|sfera_memory_percent\"}))) + ((scalar((sum(rate(sfera_http_requests_total[1m]))+sum(rate(sfera_ws_messages_received_total[1m]))+sum(rate(sfera_ws_messages_sent_total[1m])))*100/${max_ops})) - (scalar(max({__name__=~\"sfera_cpu_percent|sfera_memory_percent\"}))) > bool 0) * ((scalar((sum(rate(sfera_http_requests_total[1m]))+sum(rate(sfera_ws_messages_received_total[1m]))+sum(rate(sfera_ws_messages_sent_total[1m])))*100/${max_ops})) - (scalar(max({__name__=~\"sfera_cpu_percent|sfera_memory_percent\"}))))"
        }
      ]
    },
