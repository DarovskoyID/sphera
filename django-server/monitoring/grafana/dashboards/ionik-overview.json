{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "title": "Server Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        }
      },
      "targets": [{ "expr": "ionik_uptime_seconds", "refId": "A" }]
    },
    {
      "title": "CPU Usage %",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      },
      "targets": [{ "expr": "ionik_cpu_percent", "refId": "A" }]
    },
    {
      "title": "Memory Usage %",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "targets": [{ "expr": "ionik_memory_percent", "refId": "A" }]
    },
    {
      "title": "Disk Usage %",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "targets": [{ "expr": "ionik_disk_percent", "refId": "A" }]
    },
    {
      "title": "Process RSS Memory",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": { "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "targets": [{ "expr": "ionik_process_rss_bytes", "refId": "A" }]
    },
    {
      "title": "Threads",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "purple", "value": null }] }
        }
      },
      "targets": [{ "expr": "ionik_process_threads", "refId": "A" }]
    },

    {
      "title": "HTTP Requests / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "rate(ionik_http_requests_total[1m])", "legendFormat": "requests/s", "refId": "A" },
        { "expr": "rate(ionik_http_errors_5xx_total[1m])", "legendFormat": "5xx errors/s", "refId": "B" }
      ]
    },
    {
      "title": "HTTP Latency (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "ionik_http_latency_p50_ms", "legendFormat": "p50", "refId": "A" },
        { "expr": "ionik_http_latency_p95_ms", "legendFormat": "p95", "refId": "B" },
        { "expr": "ionik_http_latency_p99_ms", "legendFormat": "p99", "refId": "C" }
      ]
    },

    {
      "title": "WebSocket Messages / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "rate(ionik_ws_messages_received_total[1m])", "legendFormat": "received/s", "refId": "A" },
        { "expr": "rate(ionik_ws_messages_sent_total[1m])", "legendFormat": "sent/s", "refId": "B" }
      ]
    },
    {
      "title": "WebSocket Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "color": { "fixedColor": "orange", "mode": "fixed" }
        }
      },
      "targets": [
        { "expr": "ionik_ws_connections_total", "legendFormat": "total connections", "refId": "A" }
      ]
    },

    {
      "title": "Online Users",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "targets": [
        { "expr": "ionik_online_users", "legendFormat": "online", "refId": "A" }
      ]
    },
    {
      "title": "Active DM Calls",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "orange", "value": null }] }
        }
      },
      "targets": [
        { "expr": "ionik_active_dm_calls", "legendFormat": "calls", "refId": "A" }
      ]
    },
    {
      "title": "Voice Channels",
      "type": "stat",
      "gridPos": { "h": 4, "w": 2, "x": 8, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        }
      },
      "targets": [
        { "expr": "ionik_voice_channels_active", "legendFormat": "channels", "refId": "A" }
      ]
    },
    {
      "title": "Voice Users",
      "type": "stat",
      "gridPos": { "h": 4, "w": 2, "x": 10, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        }
      },
      "targets": [
        { "expr": "ionik_voice_users", "legendFormat": "in voice", "refId": "A" }
      ]
    },

    {
      "title": "Infrastructure Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [
        { "expr": "ionik_db_connected", "legendFormat": "Database", "refId": "A" }
      ]
    },
    {
      "title": "Redis Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [
        { "expr": "ionik_redis_connected", "legendFormat": "Redis", "refId": "A" }
      ]
    },
    {
      "title": "Kafka Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [
        { "expr": "ionik_kafka_connected", "legendFormat": "Kafka", "refId": "A" }
      ]
    },

    {
      "title": "Database Rows by Table",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80 }
        }
      },
      "targets": [
        { "expr": "ionik_db_rows", "legendFormat": "{{table}}", "refId": "A" }
      ]
    },
    {
      "title": "Redis Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "color": { "fixedColor": "red", "mode": "fixed" }
        }
      },
      "targets": [
        { "expr": "ionik_redis_memory_bytes", "legendFormat": "Redis used memory", "refId": "A" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ionik"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "Ionik Overview",
  "uid": "ionik-overview"
}
