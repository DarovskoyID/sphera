{
  "uid": "sfera-nodes",
  "title": "Sfera — По нодам (каждая нода отдельно)",
  "tags": [
    "sfera"
  ],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "PBFA97CFB590B2093"
        },
        "hide": 0
      },
      {
        "name": "max_ops",
        "label": "Макс. операций/сек",
        "type": "constant",
        "query": "2000",
        "current": {
          "text": "2000",
          "value": "2000"
        },
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Нода / node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(sfera_uptime_seconds, instance)",
        "query": "label_values(sfera_uptime_seconds, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "hide": 0,
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 101,
      "title": "НОДА  $instance",
      "type": "row",
      "collapsed": false,
      "repeat": "instance",
      "repeatDirection": "v",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 102,
      "title": "Общая нагрузка (операций/сек)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 16,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(sfera_http_requests_total{instance=~\"$instance\"}[1m]))+sum(rate(sfera_ws_messages_received_total{instance=~\"$instance\"}[1m]))+sum(rate(sfera_ws_messages_sent_total{instance=~\"$instance\"}[1m])))",
          "legendFormat": "ops/s"
        }
      ]
    },
    {
      "id": 103,
      "title": "Сейчас, операций/сек",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(sfera_http_requests_total{instance=~\"$instance\"}[1m]))+sum(rate(sfera_ws_messages_received_total{instance=~\"$instance\"}[1m]))+sum(rate(sfera_ws_messages_sent_total{instance=~\"$instance\"}[1m])))"
        }
      ]
    },
    {
      "id": 104,
      "title": "Загрузка относительно максимума (%) · может превышать 100%",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "description": "Общая нагрузка к номинальной ёмкости ($max_ops оп/сек), но не ниже загрузки CPU/памяти. Свыше 100% = перегруз.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 130,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(scalar(max({__name__=~\"sfera_cpu_percent|sfera_memory_percent\",instance=~\"$instance\"}))) + ((scalar((sum(rate(sfera_http_requests_total{instance=~\"$instance\"}[1m]))+sum(rate(sfera_ws_messages_received_total{instance=~\"$instance\"}[1m]))+sum(rate(sfera_ws_messages_sent_total{instance=~\"$instance\"}[1m])))*100/${max_ops})) - (scalar(max({__name__=~\"sfera_cpu_percent|sfera_memory_percent\",instance=~\"$instance\"}))) > bool 0) * ((scalar((sum(rate(sfera_http_requests_total{instance=~\"$instance\"}[1m]))+sum(rate(sfera_ws_messages_received_total{instance=~\"$instance\"}[1m]))+sum(rate(sfera_ws_messages_sent_total{instance=~\"$instance\"}[1m])))*100/${max_ops})) - (scalar(max({__name__=~\"sfera_cpu_percent|sfera_memory_percent\",instance=~\"$instance\"}))))"
        }
      ]
    },
    {
      "id": 105,
