          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max({__name__=~\"sfera_cpu_percent|sfera_memory_percent\",instance=~\"$instance\"})",
          "legendFormat": "resource %"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(sfera_http_requests_total{instance=~\"$instance\"}[1m]))+sum(rate(sfera_ws_messages_received_total{instance=~\"$instance\"}[1m]))+sum(rate(sfera_ws_messages_sent_total{instance=~\"$instance\"}[1m])))*100/${max_ops}",
          "legendFormat": "throughput %"
        }
      ]
    },
