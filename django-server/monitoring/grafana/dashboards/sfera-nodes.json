    {
      "id": 7,
      "title": "HTTP запросов/сек",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 18,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(sfera_http_requests_total{instance=\"$instance\"}[1m])",
          "legendFormat": "requests/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(sfera_http_errors_5xx_total{instance=\"$instance\"}[1m])",
          "legendFormat": "5xx errors/s"
        }
      ]
    },
    {
      "id": 8,
      "title": "WS сообщений/сек",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
