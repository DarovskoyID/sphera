# Пример loadtest.env — окружение для нагрузочной команды seed_load.
# Скопируйте в load-tests/loadtest.env НА СЕРВЕРЕ, чтобы seed_load работал с той
# же БД (Postgres) и поиском (Elasticsearch), что и сервер. На dev-машине файл
# не нужен — там используется sqlite.
POSTGRES_DB=ionik
POSTGRES_USER=ionik
POSTGRES_PASSWORD=ionikpg2026
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
ELASTICSEARCH_URL=http://127.0.0.1:9200
