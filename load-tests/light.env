# Лёгкий профиль нагрузки — быстрый прогон для разработки
ACCOUNTS=20
SERVERS=3
CHANNELS=10
POSTS=50
SERVER_MESSAGES=300
DM_MESSAGES=200
# T — реально отправить столько ЛС через HTTP API (нужен запущенный сервер). 0 = выключено.
SEND_DM=0
# I — реальные WebRTC-звонки через TURN (нужны сервер + aiortc/websockets). 0 = выключено.
ACTIVE_CALLS=0
# Длительность звонков: 300 / 300s / 5m / 1h / 1h30m
CALL_DURATION=5m

# Нагрузка на bot API: B запросов к временному боту (0 = выключено, нужен запущенный сервер)
# BOT_API_TIER: premium (2000/мин) | standard (120/мин); BOT_API_ENDPOINT: me | chats
BOT_API=0
BOT_API_TIER=premium
BOT_API_ENDPOINT=me
CONCURRENCY=64
