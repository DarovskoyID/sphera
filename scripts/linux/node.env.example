# Конфиг ДОП-НОДЫ. Скопируй в /etc/ionik/node.env на втором сервере и заполни.
#   sudo mkdir -p /etc/ionik && sudo cp scripts/linux/node.env.example /etc/ionik/node.env
#   sudo nano /etc/ionik/node.env   &&   sudo chmod 600 /etc/ionik/node.env

# WG-адрес ХАБА (главного) и этой ноды (см. wg-hub.sh / wg-node.sh).
IONIK_WG_HUB_IP=10.77.0.1
IONIK_WG_NODE_IP=10.77.0.2

# Секрет JWT — РОВНО значение IONIK_SECRET_KEY из /etc/ionik/secrets.env ГЛАВНОГО
# сервера (sudo sed -n 's/^IONIK_SECRET_KEY=//p' /etc/ionik/secrets.env на хабе).
JWT_SECRET=ВСТАВЬ_СЮДА_IONIK_SECRET_KEY_ГЛАВНОГО

# Эндпоинт авторизации WS (публичный API главного). Обычно менять не нужно.
DJANGO_WS_AUTHZ_URL=https://start-ionik.ru:8000/api/ws/authorize/
