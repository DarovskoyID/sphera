# Конфиг ДОП-НОДЫ. Скопируй в /etc/sfera/node.env на втором сервере и заполни.
#   sudo mkdir -p /etc/sfera && sudo cp scripts/linux/node.env.example /etc/sfera/node.env
#   sudo nano /etc/sfera/node.env   &&   sudo chmod 600 /etc/sfera/node.env

# WG-адрес ХАБА (главного) и этой ноды (см. wg-hub.sh / wg-node.sh).
SFERA_WG_HUB_IP=10.77.0.1
SFERA_WG_NODE_IP=10.77.0.2

# Секрет JWT — РОВНО значение SFERA_SECRET_KEY из /etc/sfera/secrets.env ГЛАВНОГО
# сервера (sudo sed -n 's/^SFERA_SECRET_KEY=//p' /etc/sfera/secrets.env на хабе).
JWT_SECRET=ВСТАВЬ_СЮДА_SFERA_SECRET_KEY_ГЛАВНОГО

# Эндпоинт авторизации WS (публичный API главного). Обычно менять не нужно.
DJANGO_WS_AUTHZ_URL=https://start-ionik.ru:8000/api/ws/authorize/
