# Креды для отправки почты через Yandex SMTP (режим --mail yandex).
# Скопируй в .mail.env (он в .gitignore) и заполни. start-common.sh подхватит
# файл при запуске start-all/start-http/start-ssl и пропишет их в systemd drop-in.
#
#   cp .mail.env.example .mail.env   &&   nano .mail.env
#
# ВАЖНО: для Yandex нужен НЕ обычный пароль, а «пароль приложения»:
#   Яндекс ID → Безопасность → Пароли приложений → создать для «Почта (SMTP)».
# Адрес From должен совпадать с аккаунтом (или быть его подтверждённым алиасом),
# иначе Yandex отклонит отправку.

# ВАЖНО: значения со спецсимволами/пробелами (особенно From с < >) — В КАВЫЧКАХ,
# иначе при сорсинге файла shell примет < > за редирект и упадёт.
IONIK_SMTP_USER=you@yandex.ru
IONIK_SMTP_PASSWORD=app-specific-password
IONIK_SMTP_FROM="Ionik <you@yandex.ru>"

# Необязательно (значения по умолчанию подходят для Yandex):
# IONIK_SMTP_HOST=smtp.yandex.ru
# IONIK_SMTP_PORT=465
# IONIK_SMTP_SSL=true        # 465=SSL(true); для 587 поставь false (будет STARTTLS)
